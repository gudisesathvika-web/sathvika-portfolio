# Frontend environment variables.
# NOTE: never put backend secrets in VITE_* variables — they are embedded in
# the browser bundle. Backend secrets live in backend/.env (e.g. DATABASE_URL).

# Public API base URL for the READ-ONLY published-project feed.
# Leave EMPTY for local development: the Vite dev server proxies /api to
# http://127.0.0.1:8000 (see vite.config.ts), so requests stay same-origin.
# For separate frontend/backend hosting, set the deployed API origin:
#   VITE_API_URL=https://api.example.com
VITE_API_URL=