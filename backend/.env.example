# Copy to `.env` and adjust. Never commit the real `.env`.

# Application
APP_NAME=Sathvika Portfolio API
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL connection (SQLAlchemy URL). Replace with your provider's URL.
# Local example:
DATABASE_URL=postgresql+psycopg://portfolio:portfolio@localhost:5432/portfolio

# Comma-separated list of allowed front-end origins for CORS.
# In production, include the deployed frontend origin (no trailing slash).
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Authentication / session ---
# Session cookie lifetime in seconds (default 43200 = 12h).
SESSION_MAX_AGE_SECONDS=43200
# Production (frontend + backend on separate origins, over HTTPS):
#   COOKIE_SECURE=true and COOKIE_SAMESITE=none are REQUIRED for cross-site
#   credentialed requests. Local dev (via the Vite proxy, same-origin) uses
#   COOKIE_SECURE=false and COOKIE_SAMESITE=lax.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Login rate limiting (in-memory, per process).
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# --- Contact form (optional; free-tier email providers) ---
# CONTACT_PROVIDER: 'mock' (default, no external sends), 'smtp', or 'resend'
# Do not commit secrets. Leave provider 'mock' to disable external delivery.
CONTACT_PROVIDER=smtp
CONTACT_API_KEY=
CONTACT_FROM_EMAIL=your-gmail-address@gmail.com
CONTACT_FROM_NAME=Sathvika Portfolio
CONTACT_TO_EMAIL=sathvikayadav3@gmail.com
CONTACT_TO_NAME=Sathvika
CONTACT_ENDPOINT_URL=
# Contact rate limiting (in-memory, per process)
CONTACT_RATE_LIMIT_MAX_ATTEMPTS=10
CONTACT_RATE_LIMIT_WINDOW_SECONDS=3600
# --- SMTP (optional; Gmail STARTTLS example) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=REPLACE_WITH_NEW_GMAIL_APP_PASSWORD
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT_SECONDS=10



# MySQL (XAMPP local development) alternative:
# DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/portfolio
